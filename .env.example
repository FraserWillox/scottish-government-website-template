# Copy this file to .env.local for local development (git-ignored).
# No variable here is required for the app to run. It works with none set.

# Absolute URL of this site once deployed. Used to build absolute metadata
# URLs (Open Graph, canonical links, robots.txt). Defaults to
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Whether search engines may index this deployment: controls both
# robots.txt (src/app/robots.ts) and a page-level noindex meta tag
# (src/app/layout.tsx). Defaults to allowing indexing (true) if unset, which
# is normally what a real deployed service wants. Set to the literal string
# "false" to disable indexing, for example for a staging or review
# deployment. `npm run build:cpanel` sets this to "false" explicitly for
# Fraser Willox's own cPanel demo build; it is not implied by any
# particular deployment target.
NEXT_PUBLIC_ALLOW_INDEXING=true
