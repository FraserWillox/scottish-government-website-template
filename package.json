{
  "name": "scottish-government-website-template",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Fraser Willox, Director, Dream Tech Ltd",
  "repository": {
    "type": "git",
    "url": "https://github.com/FraserWillox/scottish-government-website-template"
  },
  "bugs": {
    "url": "https://github.com/FraserWillox/scottish-government-website-template/issues"
  },
  "homepage": "https://sg-template.fraserwillox.com",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cpanel": "cross-env DEPLOY_TARGET=cpanel NEXT_PUBLIC_SITE_URL=https://sg-template.fraserwillox.com NEXT_PUBLIC_ALLOW_INDEXING=false node scripts/build-cpanel.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@scottish-government/design-system": "4.2.0",
    "@scottish-government/designsystem-react": "1.2.1",
    "clsx": "^2.1.1",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
